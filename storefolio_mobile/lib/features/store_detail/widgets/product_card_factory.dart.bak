import 'package:flutter/material.dart';
import 'package:cached_network_image/cached_network_image.dart';
import '../../../core/theme/app_theme.dart';
import '../../../core/models/product.dart';
import '../../../core/models/store.dart';

class ProductCardFactory extends StatelessWidget {
  final Product product;
  final Store store;
  final String style;
  final VoidCallback onTap;
  final VoidCallback onAddToCart;

  const ProductCardFactory({
    super.key,
    required this.product,
    required this.store,
    required this.style,
    required this.onTap,
    required this.onAddToCart,
  });

  @override
  Widget build(BuildContext context) {
    switch (style) {
      case 'style-1': return _buildCardStyle1();
      case 'style-2': return _buildCardStyle2();
      case 'style-3': return _buildCardStyle3();
      case 'style-4': return _buildCardStyle4();
      case 'style-5': return _buildCardStyle5();
      case 'style-6': return _buildCardStyle6();
      case 'style-7': return _buildCardStyle7();
      case 'style-8': return _buildCardStyle8();
      case 'style-9': return _buildCardStyle9();
      case 'style-10': return _buildCardStyle10();
      case 'style-11': return _buildCardStyle11();
      case 'style-12': return _buildCardStyle12();
      case 'style-13': return _buildCardStyle13();
      case 'style-14': return _buildCardStyle14();
      case 'style-15': return _buildCardStyle15();
      case 'style-16': return _buildCardStyle16();
      case 'style-17': return _buildCardStyle17();
      case 'style-18': return _buildCardStyle18();
      case 'style-19': return _buildCardStyle19();
      case 'style-20': return _buildCardStyle20();
      case 'style-21': return _buildCardStyle21();
      case 'style-22': return _buildCardStyle22();
      case 'style-23': return _buildCardStyle23();
      case 'style-24': return _buildCardStyle24();
      case 'style-25': return _buildCardStyle25();
      case 'style-26': return _buildCardStyle26();
      case 'style-27': return _buildCardStyle27();
      case 'style-28': return _buildCardStyle28();
      case 'style-29': return _buildCardStyle29();
      case 'style-30': return _buildCardStyle30();
      case 'style-31': return _buildCardStyle31();
      case 'style-32': return _buildCardStyle32();
      case 'style-33': return _buildCardStyle33();
      case 'style-34': return _buildCardStyle34();
      case 'style-35': return _buildCardStyle35();
      case 'style-36': return _buildCardStyle36();
      case 'style-37': return _buildCardStyle37();
      case 'style-38': return _buildCardStyle38();
      case 'style-39': return _buildCardStyle39();
      case 'style-40': return _buildCardStyle40();
      case 'style-41': return _buildCardStyle41();
      case 'style-42': return _buildCardStyle42();
      case 'style-43': return _buildCardStyle43();
      case 'style-44': return _buildCardStyle44();
      case 'style-45': return _buildCardStyle45();
      case 'style-46': return _buildCardStyle46();
      case 'style-47': return _buildCardStyle47();
      case 'style-48': return _buildCardStyle48();
      case 'style-49': return _buildCardStyle49();
