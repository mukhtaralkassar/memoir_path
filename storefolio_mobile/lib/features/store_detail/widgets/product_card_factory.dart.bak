// Helper enums
enum HorizontalImagePosition { left, right }
enum OverlayPosition { bottom, top, center, bottomLeft, topRight }
enum OverlayBackground { dark, lightFloating, gradientBottom, gradientTop, fullDark, coloredAccent, transparentDark }
enum BorderPosition { top, left, bottom }
enum ClipType { chevron, angled }
enum InteractiveEffect { lift, tilt, expandActions, imageZoom, slideActions, colorFrame, contentHighlight, borderGlow, aspectChange, contentScale }
