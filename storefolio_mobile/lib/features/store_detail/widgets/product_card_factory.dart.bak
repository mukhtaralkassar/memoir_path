      case 'style-74': return _buildCardStyle74();
      case 'style-75': return _buildCardStyle75();
      case 'style-76': return _buildCardStyle76();
      case 'style-77': return _buildCardStyle77();
      case 'style-78': return _buildCardStyle78();
      case 'style-79': return _buildCardStyle79();
      case 'style-80': return _buildCardStyle80();
      case 'style-81': return _buildCardStyle81();
      case 'style-82': return _buildCardStyle82();
      case 'style-83': return _buildCardStyle83();
      case 'style-84': return _buildCardStyle84();
      case 'style-85': return _buildCardStyle85();
      case 'style-86': return _buildCardStyle86();
      case 'style-87': return _buildCardStyle87();
      case 'style-88': return _buildCardStyle88();
      case 'style-89': return _buildCardStyle89();
      case 'style-90': return _buildCardStyle90();
      case 'style-91': return _buildCardStyle91();
      case 'style-92': return _buildCardStyle92();
      case 'style-93': return _buildCardStyle93();
      case 'style-94': return _buildCardStyle94();
      case 'style-95': return _buildCardStyle95();
      case 'style-96': return _buildCardStyle96();
      case 'style-97': return _buildCardStyle97();
      case 'style-98': return _buildCardStyle98();
