      case 'style-51': return _buildCardStyle51();
      case 'style-52': return _buildCardStyle52();
      case 'style-53': return _buildCardStyle53();
      case 'style-54': return _buildCardStyle54();
      case 'style-55': return _buildCardStyle55();
      case 'style-56': return _buildCardStyle56();
      case 'style-57': return _buildCardStyle57();
      case 'style-58': return _buildCardStyle58();
      case 'style-59': return _buildCardStyle59();
      case 'style-60': return _buildCardStyle60();
      case 'style-61': return _buildCardStyle61();
      case 'style-62': return _buildCardStyle62();
      case 'style-63': return _buildCardStyle63();
      case 'style-64': return _buildCardStyle64();
      case 'style-65': return _buildCardStyle65();
